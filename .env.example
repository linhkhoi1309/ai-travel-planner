# Copy to .env and fill in locally. Never commit .env.
# Every variable the app reads is listed here, with no values.

# HTTP port for `npm run dev` / `npm start` (defaults to 3000 when empty)
PORT=

# development | test | production
NODE_ENV=

# Anthropic API key for the planning agent (PA#3+). Backend only, never in the browser.
# The key has a monthly spend limit set in the Anthropic Console; see README.
ANTHROPIC_API_KEY=

# Model id used by the agent, e.g. a Claude model id
MODEL_NAME=
