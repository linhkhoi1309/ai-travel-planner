{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Read(tests/**)",
      "Read(docs/**)",
      "Edit(src/**)",
      "Edit(docs/**)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run format)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm ci)",
      "Edit(tests/**)",
      "Edit(.github/**)",
      "Edit(package.json)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.env)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(gh pr merge*--admin*)"
    ]
  }
}
